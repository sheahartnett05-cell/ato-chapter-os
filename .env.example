# Agora + Supabase (Vite React app — not Next.js)
# Copy to .env.local and fill from https://supabase.com/dashboard → Project Settings → API
#
# Use either the legacy "anon" / "public" key OR the newer "publishable" key.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias (same value as above):
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Resend OTP via Supabase custom SMTP (scripts only — do NOT use VITE_ prefix)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=auth@mail.yourdomain.com   ← must be a VERIFIED domain (not @resend.dev)
# RESEND_FROM_NAME=Agora
# RESEND_DOMAIN=mail.yourdomain.com            ← add in Resend, then: npm run configure-resend-domain -- add
# SUPABASE_ACCESS_TOKEN=sbp_...   → enables npm run configure-pilot / configure-agora-emails
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres
# PILOT_SITE_URL=https://your-app.vercel.app   → Supabase Auth site URL (after deploy)
