# Agora + Supabase (Vite React app — not Next.js)
# Copy to .env.local and fill from https://supabase.com/dashboard → Project Settings → API
#
# Use either the legacy "anon" / "public" key OR the newer "publishable" key.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias (same value as above):
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
